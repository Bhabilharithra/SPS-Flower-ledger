# Copy this file to ".env" and change these values.
# The .env file itself should NEVER be shared or committed to GitHub.

# Fallback username/password if you don't want to manage data/users.json
ADMIN_PASSWORD=flowers123
PORT=4000

# Optional: turn on the "Continue with Google" button.
# Get a client ID at https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application), then also
# run `npm install google-auth-library` in this folder.
GOOGLE_CLIENT_ID=
# Optional: comma-separated list of Google emails allowed to sign in.
# Leave blank to allow any Google account.
ALLOWED_GOOGLE_EMAILS=
